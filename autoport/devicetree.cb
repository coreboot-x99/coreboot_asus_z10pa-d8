chip northbridge/intel/grantley # Intel Haswell-EP / Broadwell-EP (Grantley LGA2011-3)
	chip cpu/intel/grantley
		device cpu_cluster 0x0 on
			ops grantley_cpu_bus_ops
		end
	end
	device domain 0x0 on
		ops grantley_pci_domain_ops
		device pci 00.0 on # Server Host bridge Host bridge
		end
		device pci 01.0 on # PCIe Root Port 1 (x16 slot)
		end
		device pci 02.0 on # PCIe Root Port 2 (x16 slot)
		end
		device pci 03.0 on # PCIe Root Port 3 (x8 slot)
		end
		device pci 05.0 on # Address Map / IIO Misc
		end
		device pci 05.1 on # IIO Hot Plug
		end
		device pci 05.2 on # IIO RAS, Error Status
		end
		device pci 05.4 on # IIO I/O APIC
		end
		chip southbridge/intel/lynxpoint # Intel 8 Series Lynx Point PCH
			register "docking_supported" = "0"
			register "gen1_dec" = "LPC_IO(0x200, 0x100)"
			register "gen2_dec" = "0x00000000"
			register "gen3_dec" = "LPC_IO(0xca0, 0x10)"
			register "gen4_dec" = "LPC_IO(0x600, 0x20)"
			register "gpe0_en_1" = "0x200"
			register "gpe0_en_2" = "0x0"
			register "sata_port0_gen3_dtle" = "0x0"
			register "sata_port1_gen3_dtle" = "0x0"
			register "sata_port_map" = "0x3f"
			device pci 14.0 on # xHCI Controller
				subsystemid 0x1043 0x85f6
			end
			device pci 16.0 on # Management Engine Interface 1
				subsystemid 0x1043 0x85f6
			end
			device pci 16.1 on # Management Engine Interface 2
				subsystemid 0x1043 0x85f6
			end
			device pci 16.2 off # Management Engine IDE-R
			end
			device pci 16.3 off # Management Engine KT
			end
			device pci 19.0 off # Intel Gigabit Ethernet
			end
			device pci 1a.0 on # USB2 EHCI #2
				subsystemid 0x1043 0x85f6
			end
			device pci 1b.0 off # High Definition Audio
			end
			device pci 1c.0 on # PCIe Port #1
				subsystemid 0x1043 0x85f6
			end
			device pci 1c.1 off # PCIe Port #2
			end
			device pci 1c.2 off # PCIe Port #3
			end
			device pci 1c.3 off # PCIe Port #4
			end
			device pci 1c.4 on # PCIe Port #5
				subsystemid 0x1043 0x85f6
			end
			device pci 1c.5 on # PCIe Port #6
				subsystemid 0x1043 0x85f6
			end
			device pci 1c.6 off # PCIe Port #7
			end
			device pci 1c.7 on # PCIe Port #8
				subsystemid 0x1043 0x85f6
			end
			device pci 1d.0 on # USB2 EHCI #1
				subsystemid 0x1043 0x85f6
			end
			device pci 1f.0 on # LPC bridge
				subsystemid 0x1043 0x85f6
			end
			device pci 1f.2 on # SATA Controller (AHCI)
				subsystemid 0x1043 0x85f6
			end
			device pci 1f.3 on # SMBus
				subsystemid 0x1043 0x85f6
			end
			device pci 1f.5 off # SATA Controller (Legacy)
			end
			device pci 1f.6 off # Thermal
			end
		end
		device pci 06.3 on # Unsupported PCI device 8086:2f13
		end
		device pci 06.0 on # Unsupported PCI device 8086:2f10
		end
		device pci 05.6 on
		end
		device pci 07.3 on # Unsupported PCI device 8086:2f1b
		end
		device pci 06.7 on # Unsupported PCI device 8086:2f17
		end
		device pci 07.2 on # Unsupported PCI device 8086:2f1a
		end
		device pci 11.0 on
			subsystemid 0x1043 0x85f6
		end
		device pci 06.1 on # Unsupported PCI device 8086:2f11
		end
		device pci 07.4 on # Unsupported PCI device 8086:2f1c
		end
		device pci 11.4 on
			subsystemid 0x1043 0x85f7
		end
		device pci 06.6 on # Unsupported PCI device 8086:2f16
		end
		device pci 07.1 on # Unsupported PCI device 8086:2f19
		end
		device pci 06.5 on # Unsupported PCI device 8086:2f15
		end
		device pci 06.4 on # Unsupported PCI device 8086:2f14
		end
		device pci 07.0 on # Unsupported PCI device 8086:2f18
		end
		device pci 06.2 on # Unsupported PCI device 8086:2f12
		end
	end
end
